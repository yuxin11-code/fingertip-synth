//File Title: Physical Constraints file
//Tool Version: V1.9.9.01 (64-bit)
//Part Number: GW5AST-LV138PG484AC2/I1
//Device: GW5AST-138
//Device Version: B
//Created Time: Mon 03 11 16:04:28 2024
// Tang Mega 138K Dock onboard WS2812 level-shifter input.
// J16 is routed to the WS2812 control net on the Dock.
IO_LOC "WS2812_DIN" J16;
IO_PORT "WS2812_DIN" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "PA_EN" AB16;
IO_PORT "PA_EN" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "HP_DIN" AA16;
IO_PORT "HP_DIN" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "HP_WS" AB17;
IO_PORT "HP_WS" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "HP_BCK" Y17;
IO_PORT "HP_BCK" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "rst" F4;
IO_PORT "rst" IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5;
// Official Tang Mega 138K Dock 31002 user buttons:
// Dock button mapping from the official schematic:
// Physical board labels confirmed for this build:
// KEY1 = EX_KEY.1 = AB13; KEY2 = EX_KEY.2 = Y12.
// Inputs are active-low with the FPGA internal pull-up.
IO_LOC "KEY1" AB13;
IO_PORT "KEY1" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "KEY2" Y12;
IO_PORT "KEY2" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// Board KEY3 / USER_BUTTON0: direct touch / gesture-only pluck toggle.
IO_LOC "TIMBRE_KEY" AA13;
IO_PORT "TIMBRE_KEY" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// Tang Mega 138K Dock 31002 PMOD1 header J8, verified against the official
// schematic: J8 pin 9 = PMOD1_IO2 (AB21), pin 10 = PMOD1_IO3 (AB22).
// TTP229 is powered from the header's +3V3 pins and uses its proprietary
// SCL/SDO two-wire serial interface.
IO_LOC "TTP229_SCL" AB21;
IO_PORT "TTP229_SCL" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "TTP229_SDO" AB22;
IO_PORT "TTP229_SDO" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// Rotary encoder on J13 / SDRAM0 header
IO_LOC "ENC_A" E14;
IO_PORT "ENC_A" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "ENC_B" E13;
IO_PORT "ENC_B" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "ENC_C" C15;
IO_PORT "ENC_C" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;


// PAJ7620 on J13 / SDRAM0 header
IO_LOC "PAJ_SCL" C14;
IO_PORT "PAJ_SCL" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "PAJ_SDA" B13;
IO_PORT "PAJ_SDA" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
// Existing pitch keys remain on J8-5/J8-6 (AA19/AB20).
// The new four-key module is wired to the Dock 31002 SDRAM1/PMOD expansion
// nets requested for this revision: K1=E19, K2=D19, K3=D20, K4=C20.
// All four inputs are active-low and use the FPGA internal pull-up.

IO_LOC "PITCH_UP_KEY" AA19;
IO_PORT "PITCH_UP_KEY" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "PITCH_DOWN_KEY" AB20;
IO_PORT "PITCH_DOWN_KEY" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// New K1/K2 timbre buttons use E19/D19; AA20 is assigned below to ESP32 TX.
IO_LOC "K_LEFT" E19;
IO_PORT "K_LEFT" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "K_RIGHT" D19;
IO_PORT "K_RIGHT" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "K_AUX3" D20;
IO_PORT "K_AUX3" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "K_AUX4" C20;
IO_PORT "K_AUX4" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// J8-12
IO_LOC "TEST_MODE_KEY" Y22;
IO_PORT "TEST_MODE_KEY" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// J9-7
IO_LOC "TTP_R_SCL" P16;
IO_PORT "TTP_R_SCL" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// J9-8
IO_LOC "TTP_R_SDO" R17;
IO_PORT "TTP_R_SDO" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// J9-5
IO_LOC "UART_TX" R18;
// Confirmed by user: J9-6 / PMOD0_IO7 / SDRAM1_D6, Dock schematic pp6/19.
IO_LOC "UART_RX" T18;
IO_PORT "UART_RX" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "UART_TX" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// Dedicated octave EC11. Bank 2: A13=SDRAM0_D7/J13-8,
// A14=SDRAM0_D6/J13-7, B15=SDRAM0_D14/J13-10 (Dock schematic pp7/19).
IO_LOC "OCT_A" A13;
IO_PORT "OCT_A" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "OCT_B" A14;
IO_PORT "OCT_B" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "OCT_SW_N" B15;
IO_PORT "OCT_SW_N" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// RP108 dedicated I2C bus, Bank 2, SDRAM0_A2/A3 -> J13-39/40.
IO_LOC "KNOB_SCL" C18;
IO_PORT "KNOB_SCL" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "KNOB_SDA" C19;
IO_PORT "KNOB_SDA" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "BLE_RX" B18;
IO_PORT "BLE_RX" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// ESP32 request output: AA20, Bank 4, confirmed hardware wiring.
// Connect to the ESP32 UART RX; keep ESP32 TX on BLE_RX/B18 (J13 pin 19).
IO_LOC "BLE_TX" AA20;
IO_PORT "BLE_TX" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
